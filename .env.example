# Copy this file to .env before running docker compose.
SQL_SA_PASSWORD=ReplaceWithAStrongSqlPassword1!
JWT_KEY=ReplaceWithARandomSecretKeyOfAtLeast32Characters
ADMIN_PHONE=09120000000
ADMIN_PASSWORD=ReplaceWithAStrongAdminPassword1!

# Browser-visible public URLs. Change these when deploying on another host.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_HUB_URL=http://localhost:5000

# Optional external messaging services.
KAVENEGAR_API_KEY=
TELEGRAM_BOT_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
FRONTEND_URL=http://localhost:3000
